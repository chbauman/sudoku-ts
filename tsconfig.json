{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "dom"],
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "strict": true
  },
  "files": ["src/main.ts", "src/sudoku.ts", "src/html_util.ts", "src/storage.ts", "src/settings.ts", "src/pages.ts"],
  "exclude": ["./node_modules/*"]
}
